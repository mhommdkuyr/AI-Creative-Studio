{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ai-creative-studio",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "assets": {
    "directory": "../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "production"
  }
}
